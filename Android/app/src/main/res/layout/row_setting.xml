<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/settingRow"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/module_card_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/settingIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/circle_icon_bg"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/baseline_settings_24"
        app:tint="@color/esports_accent" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/esports_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Setting title" />

        <TextView
            android:id="@+id/settingDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/esports_text_dim"
            android:textSize="13sp"
            tools:text="Setting description" />
    </LinearLayout>

    <TextView
        android:id="@+id/settingValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp"
        android:textColor="@color/esports_accent_2"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Value" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="center_vertical"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
