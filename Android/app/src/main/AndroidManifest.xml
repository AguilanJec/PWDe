<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <uses-sdk
        android:minSdkVersion="27"
        android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature
        android:name="android.hardware.camera2.full"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      Android 11+ package visibility: without this, isRecognitionAvailable() returns false
      and SpeechRecognizer cannot bind to the device's recognition service (Google app /
      Speech Services by Google), so voice control silently reports "not available".
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher_playstore"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_playstore"
        android:supportsRtl="true"
        android:taskAffinity=""
        android:theme="@style/AppTheme">
        <activity
            android:name=".GestureSizeActivity"
            android:exported="false"
            android:parentActivityName=".ChooseGestureActivity"
            />
        <activity
            android:name=".ChooseGestureActivity"
            android:exported="false"
            android:parentActivityName=".CursorBinding"
            />

        <activity
            android:name=".CursorBinding"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".CursorSpeed"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".JoystickConfigActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".VoiceConfigActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".PlacementEditorActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".TestStationActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".GrantPermissionActivity"
            android:exported="false"
            />
        <activity
            android:name=".ControlActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".VoiceActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".HelpActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            />
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.App.Starting">
                    <intent-filter>
                        <action android:name="android.intent.action.MAIN" />
                        <category android:name="android.intent.category.LAUNCHER" />
                    </intent-filter>
            </activity>
        <activity
            android:name=".TutorialActivity"
            android:exported="true"
            />
        <activity
            android:name=".TutorialPhoneStandActivity"
            android:exported="true"
            />
        <service
            android:name=".CursorAccessibilityService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/mouse_accessibility_service_config" />
        </service>
    </application>

</manifest>